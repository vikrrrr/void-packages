# Template file for 'rvvm'
pkgname=rvvm
version=0.6
revision=1
build_style=gnu-makefile
hostmakedepends="make git gcc"
makedepends="libX11-devel SDL2-devel"
short_desc="Virtual machine/emulator for RISC-V guests"
maintainer="Arthur Michas <vikr+void@protonmail.com>"
license="GPL-3.0-only, MPL-2.0"
homepage="https://github.com/LekKit/RVVM"
distfiles="https://github.com/LekKit/RVVM/archive/refs/tags/v${version}.tar.gz"
checksum=97e98c95d8785438758b81fb5c695b8eafb564502c6af7f52555b056e3bb7d7a

post_install() {
	vlicense LICENSE-GPL
	vlicense LICENSE-MPL
}

rvvm-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
	}
}
